{
  "manifest_version": 3,
  "version": "1.0",
  "name": "Focus",
  "description": "Focus on the important things",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assests/icon128.png",
      "128": "assests/icon128.png"
    }
  },
  "icons": {
    "16": "assests/icon128.png",
    "128": "assests/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assests/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
